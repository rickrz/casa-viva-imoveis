# =====================================================================
# Casa Viva Imóveis — modelo de variáveis de ambiente
# ---------------------------------------------------------------------
# 1. Copie este arquivo para backend/.env
# 2. Substitua os valores fictícios pelos seus valores reais
# 3. NUNCA commite o arquivo .env (ele está no .gitignore)
# =====================================================================

# Connection string do PostgreSQL/Neon (use ?sslmode=require)
DATABASE_URL=postgresql://USUARIO:SENHA@HOST.neon.tech/casa_viva?sslmode=require

# Chave da API do Gemini — usada somente no back-end pela assistente Lia.
# Obtenha em: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=COLOQUE_SUA_CHAVE_AQUI

# Modelo principal e modelos de reserva (opcionais)
GEMINI_MODEL=gemini-flash-latest
GEMINI_MODEL_FALLBACKS=gemini-3.5-flash-lite,gemini-flash-lite-latest

# 1 = modo debug do Flask (não usar em produção)
FLASK_DEBUG=0

# Origens autorizadas a chamar a API (separadas por vírgula)
ALLOWED_ORIGINS=http://localhost:5000,http://127.0.0.1:5000,http://localhost:5500,http://127.0.0.1:5500
